    <batchstep method="io.github.mzmine.modules.dataprocessing.group_spectral_networking.MainSpectralNetworkingModule" module_name="Spectral / Molecular Networking" parameter_version="2">
        <parameter name="Feature lists" type="BATCH_LAST_FEATURELISTS"/>
        <parameter name="Algorithm" selected_item="Modified cosine">
            <module name="Modified cosine">
                <parameter name="m/z tolerance">
                    <absolutetolerance>0.005</absolutetolerance>
                    <ppmtolerance>5.0</ppmtolerance>
                </parameter>
                <parameter name="Merge &amp; select fragment scans" selected_item="simple_merged">
