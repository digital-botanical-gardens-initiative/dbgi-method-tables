        </parameter>
        <parameter name="Side chain parameters">
            <parameter name="Minimum chain length">4</parameter>
            <parameter name="Maximum chain length">26</parameter>
            <parameter name="Minimum number of DBEs">0</parameter>
            <parameter name="Maximum number of DBEs">6</parameter>
            <parameter name="Only search for even chain length">false</parameter>
        </parameter>
        <parameter name="m/z tolerance MS1 level:">
            <absolutetolerance>5.0E-4</absolutetolerance>
            <ppmtolerance>2.0</ppmtolerance>
        </parameter>
        <parameter name="Minimum overall quality score [%]">0.6</parameter>
        <parameter name="Override quality score weights" selected="false">
            <parameter name="MS1 accuracy weight">40</parameter>
            <parameter name="MS2 evidence weight">100</parameter>
            <parameter name="Adduct weight (match)">10</parameter>
            <parameter name="Adduct weight (missing ion identity)">10</parameter>
            <parameter name="Adduct weight (mismatch)">50</parameter>
            <parameter name="Isotope similarity weight">20</parameter>
            <parameter name="Interference weight">5</parameter>
            <parameter name="Elution-order weight (no trend support)">30</parameter>
            <parameter name="Elution-order weight (trend support)">10</parameter>
        </parameter>
        <parameter name="Search for lipid class specific fragments in MS/MS spectra" selected="true">
            <parameter name="Merge &amp; select fragment scans" selected_item="input_scans">
                <module name="simple_merged">
                    <parameter name="Presets">representative_scans</parameter>
                    <parameter name="Merging m/z tolerance">
                        <absolutetolerance>0.008</absolutetolerance>
                        <ppmtolerance>25.0</ppmtolerance>
                    </parameter>
                </module>
                <module name="preset_merged">
                    <parameter name="Presets">representative_scans</parameter>
                    <parameter name="Merging m/z tolerance">
                        <absolutetolerance>0.008</absolutetolerance>
                        <ppmtolerance>25.0</ppmtolerance>
                    </parameter>
                    <parameter name="Merge">
                        <selected>across_samples</selected>
                    </parameter>
                    <parameter name="Intensity merge mode">MAXIMUM</parameter>
                </module>
                <module name="input_scans">
                    <parameter name="Select input scans">all_scans</parameter>
                </module>
            </parameter>
            <parameter name="m/z tolerance MS2 level:">
                <absolutetolerance>0.001</absolutetolerance>
                <ppmtolerance>2.0</ppmtolerance>
            </parameter>
            <parameter name="Keep unconfirmed annotations">false</parameter>
        </parameter>
        <parameter name="Search for custom lipid class" selected="false">
            <parameter name="Custom lipid classes"/>
        </parameter>
        <parameter name="Advanced" selected="false">
            <parameter name="Ions to ignore">
